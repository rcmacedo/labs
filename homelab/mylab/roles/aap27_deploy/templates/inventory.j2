# Ansible Automation Platform 2.7 - Enterprise topology (disconnected bundle)
# Generated dynamically from vms_all.aap
# Each VM may define installer group(s) via roles: [group, ...] or role: group

{% set ns = namespace(groups=[]) %}
{% for h in vms_all.aap %}
{%   for r in h.roles | default([h.role]) %}
{%     if r not in ns.groups %}
{%       set _ = ns.groups.append(r) %}
{%     endif %}
{%   endfor %}
{% endfor %}

{% for group in ns.groups | sort %}
[{{ group }}]
{% for h in vms_all.aap if group in (h.roles | default([h.role])) %}
{{ h.name }}.{{ domain }} ansible_host={{ h.ip }}
{% endfor %}

{% if group == "automationcontroller" %}
[automationcontroller:vars]
peers=execution_nodes

{% endif %}
{% endfor %}

# Installer host (Fedora control node) — must be in a host group, not under [all:vars]
[local]
localhost ansible_connection=local ansible_user={{ ansible_user_id | default(ansible_env.USER) }} ansible_become=false

[all:vars]
ansible_user={{ aap_install_user }}
ansible_ssh_private_key_file=/home/{{ ansible_user_id | default(ansible_env.USER) }}/.ssh/id_rsa
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# Disconnected (bundled) installation
bundle_install=true
bundle_dir={{ aap_setup_install_dir }}/bundle

# Database
postgresql_admin_username={{ postgresql_admin_username }}
postgresql_admin_password={{ aap_password }}

redis_mode=standalone

{% set ns_db = namespace(host=none) %}
{% for h in vms_all.aap %}
{%   if 'database' in (h.roles | default([h.role])) %}
{%     set ns_db.host = h %}
{%   endif %}
{% endfor %}
{% set db_host = ns_db.host %}

# Platform gateway
gateway_admin_password={{ aap_password }}
gateway_pg_host={{ db_host.name }}.{{ domain }}
gateway_pg_password={{ aap_password }}

# Automation controller
controller_admin_password={{ aap_password }}
controller_pg_host={{ db_host.name }}.{{ domain }}
controller_pg_password={{ aap_password }}

# Automation hub
hub_admin_password={{ aap_password }}
hub_pg_host={{ db_host.name }}.{{ domain }}
hub_pg_password={{ aap_password }}
hub_seed_collections=false

# Event-Driven Ansible controller
eda_admin_password={{ aap_password }}
eda_pg_host={{ db_host.name }}.{{ domain }}
eda_pg_password={{ aap_password }}

# ==============================================================================
# CONFIGURAÇÕES DO RED HAT ANSIBLE LIGHTSPEED
# ==============================================================================

# Configurações administrativas básicas do Lightspeed

lightspeed_admin_user=admin
lightspeed_admin_password={{ aap_password }}
lightspeed_admin_email=admin@lab.example

# Conexão do Lightspeed ao banco

lightspeed_pg_host={{ db_host.name }}.{{ domain }}
lightspeed_pg_password={{ aap_password }}
lightspeed_pg_database=lightspeed

# ==============================================================================
# CONFIGURAÇÃO DO AUTOMATION INTELLIGENT ASSISTANT (CHATBOT)
# ==============================================================================

# Configuração exclusiva do Chatbot usando OpenAI (defina em vars/secrets.yml ou -e)
lightspeed_chatbot_default_provider='openai'
lightspeed_chatbot_model_url='https://api.openai.com/v1'
lightspeed_chatbot_model_api_key='{{ lightspeed_chatbot_model_api_key }}'
lightspeed_chatbot_model_id='{{ lightspeed_chatbot_model_id | default("gpt-4o-mini") }}'

# Metrics service (required in AAP 2.7 when automationcontroller is present)
automationmetrics_pg_host={{ db_host.name }}.{{ domain }}
automationmetrics_pg_password={{ aap_password }}
automationmetrics_controller_read_pg_host={{ db_host.name }}.{{ domain }}
automationmetrics_controller_read_pg_password={{ aap_password }}
